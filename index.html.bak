<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO & Accessibility -->
  <title>Pocket Sweets - Modern Doraemon Dessert Experience</title>
  <meta name="description" content="A premium, minimalist Doraemon themed dessert shop. Savor modern Dorayaki and futuristic treats.">
  
  <!-- Favicon (Bell logo) -->
  <link rel="icon" type="image/png" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><circle cx=%2250%22 cy=%2250%22 r=%2240%22 fill=%22%23ffd31d%22 stroke=%22%230f172a%22 stroke-width=%228%22/><circle cx=%2250%22 cy=%2270%22 r=%2210%22 fill=%22%230f172a%22/><line x1=%2250%22 y1=%2238%22 x2=%2250%22 y2=%2260%22 stroke=%22%230f172a%22 stroke-width=%228%22/></svg>">

  <!-- Icons & Fonts -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="assets/styles.css?v=2.1">
</head>
<body>

  <!-- Floating Bamboo Copter Spawner Badge -->
  <div class="copter-spawner-badge" id="bamboo-spawner" role="button" aria-label="Spawn floating bamboo copter sweets" title="Spawn flying sweets!">
    🚁
  </div>

  <!-- Header -->
  <header id="site-header">
    <div class="container">
      <a href="#" class="logo" id="header-logo" aria-label="Pocket Sweets Home">
        <div class="logo-bell" aria-hidden="true"></div>
        <span class="logo-text">Pocket Sweets</span>
      </a>

      <nav aria-label="Main Navigation">
        <ul class="nav-links" id="main-nav-links">
          <li><a href="#hero">Home</a></li>
          <li><a href="#menu">Menu</a></li>
          <li><a href="#customizer">Memory Bread</a></li>
          <li><a href="#anywhere-door">Portal</a></li>
        </ul>
      </nav>

      <div class="header-actions">
        <button class="cart-icon" id="header-cart-btn" aria-label="Cart">
          <i class="fa-solid fa-basket-shopping"></i>
          <span class="cart-badge" id="cart-badge-count">0</span>
        </button>
        <a href="#menu" class="btn btn-primary" id="nav-order-btn">Order Now</a>
      </div>
    </div>
  </header>

  <main>
    <!-- Hero Section -->
    <section class="hero" id="hero">
      <div class="container hero-grid">
        <div class="hero-content">
          <div class="hero-tag" id="hero-mini-tag">
            22nd Century Sweet Delights
          </div>
          <h1 class="hero-title" id="hero-headline">
            Futuristic Sweetness.<br>Perfected.
          </h1>
          <p class="hero-desc" id="hero-paragraph">
            Nobita's favorite premium dessert laboratory. Crafted with organic ingredients, magic gadgets, and childhood nostalgia.
          </p>
          <div class="hero-buttons">
            <a href="#menu" class="btn btn-primary" id="hero-primary-btn">Sweets Menu</a>
            <a href="#pocket" class="btn btn-secondary" id="hero-secondary-btn">Open 4D Pocket</a>
          </div>
        </div>

        <div class="hero-img-container">
          <div class="speech-bubble" id="doraemon-speech" role="button">
            <span id="speech-text">Hungry? Tap me for a fresh Dorayaki! 🥞</span>
          </div>

          <div class="hero-img-wrapper">
            <img src="assets/images/doraemon_dessert_hero.png" alt="Doraemon Dessert Platter" class="hero-img" id="hero-doraemon-img">
          </div>
        </div>
      </div>
    </section>

    <!-- Sleek Anywhere Door Theme switcher -->
    <section class="container" id="anywhere-door">
      <div class="anywhere-door-section">
        <div class="door-widget-container">
          <div class="door-widget-left">
            <span class="section-subtitle">Dimension Portal</span>
            <h3 id="current-theme-name">Current Dimension: 🌾 Dorayaki Meadow</h3>
            <p>Click the custom Anywhere Door on the right to teleport your surroundings!</p>
          </div>
          
          <div class="door-action-wrapper">
            <!-- Redesigned as a solid div element to avoid default button rendering cuts and make it highly visible! -->
            <div class="door-toggle-btn" id="magical-door" role="button" aria-label="Toggle Portal">
              <div class="door-toggle-portal">
                <div class="portal-particles"></div>
              </div>
              <div class="door-toggle-leaf" id="magic-door-leaf">
                <div class="door-toggle-knob"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Modern Hover Reveal Menu Section -->
    <section class="menu-section" id="menu">
      <div class="container">
        <div class="section-header">
          <span class="section-subtitle">Signature Treats</span>
          <h2 class="section-title">Magical Pastry Lab</h2>
        </div>

        <div class="menu-grid" id="dessert-menu-grid">
          <!-- Card 1: Traditional Dorayaki -->
          <div class="menu-card" data-item-id="dorayaki">
            <div class="card-img-container">
              <img src="assets/images/doraemon_desserts.png" alt="Golden Red-Bean Dorayaki" class="card-img">
              
              <!-- Clean default view bottom bar -->
              <div class="card-info-bar">
                <span class="bar-title">Red-Bean Dorayaki</span>
                <span class="bar-price">$4.50</span>
              </div>
              
              <!-- Slide-Up Hover Details Overlay -->
              <div class="card-hover-overlay">
                <h4 class="overlay-title">Red-Bean Dorayaki</h4>
                <p class="overlay-desc">Doraemon's favorite. House-made sweet red bean paste layered inside fluffy honey pancakes.</p>
                <button class="btn-overlay-cart" onclick="addToCart('Red-Bean Dorayaki', 4.50)">
                  Add to Cart +
                </button>
              </div>
            </div>
          </div>

          <!-- Card 2: Memory Bread French Toast -->
          <div class="menu-card" data-item-id="memory-bread">
            <div class="card-img-container">
              <div style="width:100%; height:100%; display:flex; justify-content:center; align-items:center; background: #ffeaa7; font-size:5rem;" class="card-img">🍞</div>
              
              <div class="card-info-bar">
                <span class="bar-title">Memory French Toast</span>
                <span class="bar-price">$6.25</span>
              </div>
              
              <div class="card-hover-overlay">
                <h4 class="overlay-title">Memory French Toast</h4>
                <p class="overlay-desc">Sweet caramelized French brioche slice embossed with sweet edible numbers.</p>
                <button class="btn-overlay-cart" onclick="addToCart('Memory French Toast', 6.25)">
                  Add to Cart +
                </button>
              </div>
            </div>
          </div>

          <!-- Card 3: Anywhere Door Raspberry Tart -->
          <div class="menu-card" data-item-id="anywhere-door-tart">
            <div class="card-img-container">
              <div style="width:100%; height:100%; display:flex; justify-content:center; align-items:center; background: #ff7875; font-size:5rem;" class="card-img">🍰</div>
              
              <div class="card-info-bar">
                <span class="bar-title">Anywhere Door Tart</span>
                <span class="bar-price">$7.50</span>
              </div>
              
              <div class="card-hover-overlay">
                <h4 class="overlay-title">Anywhere Door Tart</h4>
                <p class="overlay-desc">Molten dark chocolate tart topped with acid raspberries and custom strawberry glazes.</p>
                <button class="btn-overlay-cart" onclick="addToCart('Anywhere Door Tart', 7.50)">
                  Add to Cart +
                </button>
              </div>
            </div>
          </div>

          <!-- Card 4: Bamboo Copter Mochi Cupcake -->
          <div class="menu-card" data-item-id="copter-cupcake">
            <div class="card-img-container">
              <div style="width:100%; height:100%; display:flex; justify-content:center; align-items:center; background: #a5dbf5; font-size:5rem;" class="card-img">🧁</div>
              
              <div class="card-info-bar">
                <span class="bar-title">Bamboo Cloud Mochi</span>
                <span class="bar-price">$5.75</span>
              </div>
              
              <div class="card-hover-overlay">
                <h4 class="overlay-title">Bamboo Cloud Mochi</h4>
                <p class="overlay-desc">Sponge velvet cupcake topped with light cloud vanilla mochi and miniature prop details.</p>
                <button class="btn-overlay-cart" onclick="addToCart('Bamboo Cloud Mochi', 5.75)">
                  Add to Cart +
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Memory Bread Interactive dynamic customizer! -->
    <section class="toast-section" id="customizer">
      <div class="container toast-grid">
        <div class="toast-customizer-card">
          <span class="section-subtitle">Interactive Magic</span>
          <h3>Memory Toast Printer</h3>
          <p>Type your math formulas, study notes, or sweet wishes below and watch them print instantly onto your Memory Bread slice in real-time!</p>
          
          <div class="toast-input-group">
            <label for="bread-custom-text">Enter Custom Formula / Notes</label>
            <input type="text" id="bread-custom-text" class="toast-input" placeholder="e.g. E = mc² or Love you!" value="2 + 3 = 5" maxlength="25">
          </div>
        </div>

        <div class="toast-preview-container">
          <div class="toast-slice" id="bread-toast-render">
            <div class="toast-crust-indent"></div>
            <span class="toast-text-overlay" id="toast-live-text">2 + 3 = 5</span>
          </div>
        </div>
      </div>
    </section>

    <!-- 4D Pocket Section -->
    <section class="container" id="pocket">
      <div class="pocket-card">
        <div class="pocket-text">
          <h2>Retrieve Future Tickets</h2>
          <p>Reach inside Doraemon's signature 4D pocket for randomized gadget coupons and discounts.</p>
        </div>

        <div class="pocket-trigger" id="pocket-clickable-widget" role="button" aria-label="Interact with 4D Pocket">
          <div class="pocket-trigger-lip"></div>
          <span class="pocket-trigger-label">4D Pocket</span>
        </div>
      </div>
    </section>

    <!-- Minimal Reviews -->
    <section class="reviews-section" id="reviews">
      <div class="container">
        <div class="section-header" style="text-align: center;">
          <span class="section-subtitle">Neighborhood Stories</span>
          <h2 class="section-title">Tested by Friends</h2>
        </div>

        <div class="reviews-grid">
          <div class="review-card">
            <p class="review-text">"The Memory French Toast is incredibly delicious. And it actually works for exam mornings!"</p>
            <div class="review-author">
              <span class="author-emoji">👓</span>
              <div>
                <h4 class="author-name">Nobita Nobi</h4>
                <p class="author-role">Regular Customer</p>
              </div>
            </div>
          </div>

          <div class="review-card">
            <p class="review-text">"The Red-Bean Dorayaki is the best in the century! I have automated weekly orders."</p>
            <div class="review-author">
              <span class="author-emoji">🐱</span>
              <div>
                <h4 class="author-name">Doraemon</h4>
                <p class="author-role">Gadget Inspector</p>
              </div>
            </div>
          </div>

          <div class="review-card">
            <p class="review-text">"Beautiful styling and lovely ambiance shifts! The Anywhere Door tart is extremely refined."</p>
            <div class="review-author">
              <span class="author-emoji">🌸</span>
              <div>
                <h4 class="author-name">Shizuka</h4>
                <p class="author-role">Sweets Critic</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>

  <!-- Footer -->
  <footer>
    <div class="container">
      <div class="footer-top">
        <a href="#" class="logo">
          <div class="logo-bell" aria-hidden="true"></div>
          <span class="logo-text">Pocket Sweets</span>
        </a>
        <div class="footer-socials">
          <a href="#" class="social-link" aria-label="Instagram"><i class="fa-brands fa-instagram"></i></a>
          <a href="#" class="social-link" aria-label="Twitter"><i class="fa-brands fa-twitter"></i></a>
        </div>
      </div>
      <div class="footer-bottom">
        <p>&copy; 2026 Pocket Sweets. Inspired by Doraemon childhood magic.</p>
        <p>Premium 22nd Century Baking Lab</p>
      </div>
    </div>
  </footer>

  <!-- Modal overlay -->
  <div class="modal-overlay" id="gadget-modal" role="dialog" aria-modal="true">
    <div class="modal-content">
      <button class="modal-close" id="modal-close-btn" aria-label="Close modal">&times;</button>
      <div class="modal-emoji" id="modal-gadget-emoji">🍞</div>
      <h3 class="modal-title" id="modal-title-heading">Coupon Claimed!</h3>
      <p class="modal-desc" id="modal-gadget-desc">Wow, you pulled a memory card from the pocket! Use code below for discount at checkout.</p>
      <div class="coupon-box" id="modal-coupon-code">CODE: MEMORY15</div>
    </div>
  </div>

  <!-- Confetti script -->
  <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
  <script src="assets/script.js?v=2.0"></script>
</body>
</html>
